# Docker Compose reads .env automatically. Use a password made of letters, digits, _ and -.
WEB_PORT=8000
POSTGRES_DB=reconciliation
POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=change_me_local_only

# For a local Uvicorn process, set DATABASE_URL in the shell when using PostgreSQL.
# Without DATABASE_URL the application uses sqlite:///./reconciliation.db.
